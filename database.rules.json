{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      "$uid": {
        "profile": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",

          "displayName": { ".read": true },
          "username": { ".read": true },
          "photoURL": { ".read": true },
          "profileUrl": { ".read": true }
        },

        "entitlements": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
          ".write": "auth != null && ((auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com') || (auth.uid === $uid && !data.exists() && newData.child('plan').val() === 'free' && newData.child('isVerified').val() === false && newData.child('status').val() === 'active'))",

          "plan": { ".read": true },
          "isVerified": { ".read": true },
          "verificationTier": { ".read": true },
          "badgeIcon": { ".read": true },
          "badgeColor": { ".read": true }
        },
        "subscriptions": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')"
        },
        "payments": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
          ".write": "auth != null && auth.uid === $uid"
        },
        "warnings": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
          ".write": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')"
        },
        "loginHistory": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "usernames": {
      ".read": true,
      ".write": "auth != null"
    },

    "messages": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      "$messageId": {
        ".read": "auth != null && (data.child('recipientId').val() === auth.uid || data.child('senderId').val() === auth.uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
        ".write": true
      }
    },

    "messagesByRecipient": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
        ".write": true
      }
    },

    "messagesBySender": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
        ".write": true
      }
    },

    "deletedMessages": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".write": "auth != null",
      ".indexOn": ["senderId", "recipientId"]
    },

    "platformSettings": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')"
    },

    "conversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "reports": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".write": "auth == null || (auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com'))",
      "$reportId": {
        ".write": true
      }
    },

    "blocks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "verifications": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".indexOn": ["status"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')"
      }
    },

    "analyticsEvents": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".write": true
    },

    "subscriptions": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".write": "auth != null"
    },

    "payments": {
      ".read": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')",
      ".write": "auth != null"
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'elfannanm@gmail.com' || auth.token.email === 'mohamednasrofficial@gmail.com')"
    }
  }
}
